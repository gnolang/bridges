+// saveDirtyChildrenFirst saves oo's still-dirty, non-escaped children that
+// belong to this realm's updated set (recursively), then oo itself.
+func (rlm *Realm) saveDirtyChildrenFirst(store Store, oo Object, tids map[TypeID]struct{}, dirtySet map[Object]struct{}) {
+	for _, ch := range getUnsavedChildObjects(oo) {
+		if !ch.GetIsDirty() || ch.GetIsEscaped() || ch.GetIsNewEscaped() {
+			continue
+		}
+		if _, ok := dirtySet[ch]; !ok {
+			continue
 		}
+		rlm.saveDirtyChildrenFirst(store, ch, tids, dirtySet)
 	}
+	rlm.assertObjectIsPublic(oo, store, tids)
+	rlm.saveObject(store, oo)
+	oo.SetIsDirty(false, 0)
 }
 
