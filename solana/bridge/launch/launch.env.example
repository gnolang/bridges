# The launch's values (bridge/launch/launch.sh, stage.sh; bridge/PLAN.md §5.3, §5.8, §6.6, §11.16): copy to
# launch.env beside the keys it names, fill every FILL, keep it 0600 — the provider URLs may carry API keys. A plain
# sh file: launch.sh and stage.sh source it. No value here defaults to a shared deployment (§5.9); the defaults are
# the plan's launch values for gnoland-1 and Solana mainnet.

# --- where the launch writes: the tools, the programs' builds, the program ids (ids.env), the staged packages and
# their manifest, the logs, the costs, the machines' configs — never a key (resume reads it back)
OUT=$HOME/.config/bubblerumble-jarvis/bridge-mainnet/launch

# --- which half runs here (keys never move, RESUME.md §7): all (the deployer's keypair, the six program keypairs and
# the governor's keybase on this one machine), solana (steps a–c where the deployer's and the program keypairs are),
# or gno (steps a and c–h where the governor's keybase is, after $OUT was copied here from the Solana half's machine)
PART=all

# --- gno.land
GNO_RPC=https://rpc.gno.land:443          # the node launch.sh reads and sends through (its own node, if it has one)
GNO_CHAIN_ID=gnoland-1
GNO_DOMAIN=1198419788                      # gno.land's Hyperlane domain on gnoland-1 ("GnoL", §13); the realms derive it from the chain id, stage.sh checks the two agree
GNO_GAS_PRICE_FLOOR=0.001                  # ugnot per gas: the least an upload pays (the chain's auth/gasprice when higher, §5.7)

# --- the governor (M1k, §11.16): a new hot key on the kourt box, operated by jarvis, until he yields to GovDAO.
# Its address is the namespace the bridge's packages deploy under (gno.land/p/<GOV_ADDR>/…, gno.land/r/<GOV_ADDR>/…),
# compiled into the five realms as launchGovernor; it uploads them and calls Launch. It needs the GNOT the preflight
# names (the uploads' storage deposits and gas). The keybase's password is empty (-insecure-password-stdin).
GOV_ADDR=FILL
GOV_HOME=FILL                              # the gnokey home holding it, e.g. $HOME/.config/bridge-governor/gnokey (PART all or gno)
GOVERNOR=                                  # the realms' governor when not GOV_ADDR (gnoland-1 lets only its run_submitters send the
                                           # MsgRun every decision is; Jae's cold key g1ecsu… is one): empty = GOV_ADDR
INERT_MAX_DEPOSIT=100000000                # a parked package's storage cap, ugnot (gnoland-1 parks uploads: inert policy)
GOV_KEY=governor                           # its name in that keybase

# --- the BUBBLE token realm: live since 2026-09-25 and never redeployed; its imports (and its own p/ packages) stay at
# their live paths, and the routes' bubblePath is pinned to it
BUBBLE_TOKEN=gno.land/r/g1leu8d2vsplhehcfkjg50mwgdpxdkt8tztu95wr/bubble

# --- the four guardian seats and the two watch slots (§5.3, §11.9: the operator's own until the outsiders are seated
# at the yield): each a gno address (hlmailbox's seat) and a Solana pubkey (the pausable ISM's and the admin program's);
# no key in two seats or in a seat and a slot
GUARDIAN1_GNO=FILL
GUARDIAN1_SOL=FILL
GUARDIAN2_GNO=FILL
GUARDIAN2_SOL=FILL
GUARDIAN3_GNO=FILL
GUARDIAN3_SOL=FILL
GUARDIAN4_GNO=FILL
GUARDIAN4_SOL=FILL
WATCH5_GNO=FILL                            # monitor 1's watch key (seat 5)
WATCH5_SOL=FILL
WATCH6_GNO=FILL                            # monitor 2's watch key (seat 6)
WATCH6_SOL=FILL

# --- the three signers (§5.6): each machine's ed25519 public (`hlkey new` on the machine, `hlkey show` to read it), where
# it serves its signatures (HTTPS), and the rule: 2 of 3
SIGNER1_PUB=FILL
SIGNER1_URL=FILL                           # e.g. https://signer1.example:9100
SIGNER2_PUB=FILL
SIGNER2_URL=FILL
SIGNER3_PUB=FILL
SIGNER3_URL=FILL
SIGNER_THRESHOLD=2

# --- the treasurer (§5.5, §11.12): r/hlfees' withdrawer on gno.land, and the Solana mailbox's fee beneficiary
TREASURER_GNO=FILL
TREASURER_SOL=FILL

# --- the locks the launch notice expects in the first week, base units (6 decimals: 250000000000 is 250,000), per token
# (§5.4, §11.11: the plan's default of 250,000 each — the pausable ISM's launch day cap is a tenth, 25,000 a day, and
# the per-message maximum the realms' compiled 25,000)
EXPECTED_LOCK_GNOT=250000000000
EXPECTED_LOCK_BUBBLE=250000000000

# --- Solana
SOL_RPC=FILL                               # the deployer's RPC: the deploys, Hyperlane's inits right after each (§5.8 asks for a private path)
SOL_DOMAIN=1399811149                      # Solana mainnet's domain (§13); stage.sh checks it against the realms' own
DEPLOYER=$HOME/.config/bubblerumble-jarvis/bridge-mainnet/deployer.json   # the deployer keypair (§11.4: ≈15.36 SOL after the 8 SOL; PART all or solana,
                                           # as are PROGRAM_KEYS, SOLBIN and HYPERLANE_SO below)
PROGRAM_KEYS=FILL                          # a directory of six FRESH RANDOM program keypairs, mailbox.json gnot.json bubble.json client.json
                                           # pausable.json admin.json, each from `solana-keygen new --no-bip39-passphrase -o …` — never
                                           # `hlsol keygen -seed` (anyone can derive those; launch.sh refuses the e2e's)
SOLBIN=$HOME/.local/share/solana-3.0.14/solana-release/bin   # the Solana CLI 3.0.14 and cargo-build-sbf
HYPERLANE_SO=$HOME/.config/bubblerumble-jarvis/bridge-ref/so # mailbox.so and token.so, Hyperlane's mainnet builds byte for byte
                                           # (bridge/local/dump-programs.py; launch.sh dumps them there if absent)
FACTOR=1                                   # the programs' clock factor: 1 on mainnet (§5.9), as the realms compile
ATA_FUND=250000000                         # lamports to each token's ATA payer at the setup (§5.8: 0.25 SOL; §11.4 tops them to 1.25)
DEPLOY_SEND=tpu                            # the deploys' writes: tpu (straight to the leaders) or rpc (through SOL_RPC; a free
                                           # endpoint's rate limit dropped the first mainnet try's burst of writes)
DEPLOY_MAX_SIGN_ATTEMPTS=50                # re-sign the unconfirmed writes this many times as blockhashes expire
DEPLOY_CU_PRICE=20000                      # the writes' priority fee, micro-lamports a compute unit (≈0.0004 SOL for all six)
AUTHORITY_FUND=10000000                    # lamports to the admin program's authority PDA (the realloc float, §5.8)
GNOT_NAME=Gno                              # the tokens' metadata: written by the setup, then its authority burned (§11.5) —
GNOT_SYMBOL=GNOT                           # final at the setup, so the URIs (the images are Jae's) are filled first
GNOT_URI=
BUBBLE_NAME=Bubble
BUBBLE_SYMBOL=BUBBLE
BUBBLE_URI=

# --- the machines (launch.sh writes their configs into $OUT/configs; the paths below are on the machines)
# PROVIDERS: each machine's two Solana providers, role=URL,URL, whitespace between entries — the roles signer1,
# signer2, signer3, monitor1, monitor2 (the updater and the primary relayer run on monitor 1, the backup relayer on
# monitor 2, §5.5). The signers' rule (§5.6, `hlbridge providers`): two different providers each, no pair shared by
# two signers, no provider in more than two (four providers across the three); a monitor's pair is its own, never a
# signer's. Public endpoints for the testing phase, e.g. https://api.mainnet-beta.solana.com,
# https://solana-rpc.publicnode.com, … — the archive reads the monitors' record scan makes may want a provider of
# their own (a public endpoint may refuse or rate-limit them).
PROVIDERS="
signer1=FILL,FILL
signer2=FILL,FILL
signer3=FILL,FILL
monitor1=FILL,FILL
monitor2=FILL,FILL
"
NODE_RPC=http://127.0.0.1:26657            # each machine's own gno full node (the signers' commit verification is their own node)
GNO_SOURCES=https://rpc.gno.land:443       # the other sources each signer and monitor compares with: rpc.gno.land, then a second public endpoint
MACHINE_GNOKEY=gnokey                      # gnokey on the monitor machines
MACHINE_GNOKEY_HOME=FILL                   # the keybase on the monitor machines (the relayers' gas key, the watch key)
RELAYER_GNO_KEY=relayer                    # the relayers' gas-only gno key's name there (primary and backup share it; 500 GNOT, §5.5)
RELAYER_GNO_ADDR=FILL
RELAYER_SOL_KEY=FILL                       # the relayers' SOL key file on both monitor machines
UPDATER_SOL_PUB=FILL                       # the updater's SOL key (on monitor 1; 0.3 SOL, §5.5)
UPDATER_SOL_KEY=FILL                       # its file on monitor 1
WATCH5_GNO_KEY=watch                       # seat 5's gno key's name in monitor 1's keybase
WATCH5_SOL_KEY=FILL                        # seat 5's Solana key file on monitor 1
WATCH6_GNO_KEY=watch                       # seat 6's in monitor 2's keybase
WATCH6_SOL_KEY=FILL                        # seat 6's Solana key file on monitor 2
ALARM_WEBHOOK=                             # every alarm as one JSON POST ("" logs only)

# --- the site (bridge/SITE.md): its backend's providers
SITE_GNO_RPC=https://rpc.gno.land:443
SITE_SOL_RPC=FILL
SITE_EXPLORER=https://explorer.solana.com
SITE_CLUSTER=                              # the explorer's cluster parameter ("" on mainnet)

# --- LAUNCH=no stops before the governor's Launch (step f), so the deployment's checklist goes out first (§6.6); a
# second run with `resume` and LAUNCH=yes launches
LAUNCH=yes
